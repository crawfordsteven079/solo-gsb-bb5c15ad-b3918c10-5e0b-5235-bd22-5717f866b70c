# Web 应用宿主机映射端口（访问地址 http://localhost:${APP_PORT}）
APP_PORT=3000
# PostgreSQL 宿主机映射端口（不需要本机直连可改成只在内网暴露）
PG_PORT_HOST=5432

# 数据库连接
PGUSER=lightuser
PGPASSWORD=lightpass
PGDATABASE=lightquota

# 会话密钥（生产环境务必修改）
SESSION_SECRET=please-change-this-secret

# 初始本地账号（首次启动自动创建；修改后重启会同步更新密码）
CONSERVATOR_USER=conservator
CONSERVATOR_PASSWORD=conservator123
INSTALLER_USER=installer
INSTALLER_PASSWORD=installer123

# 时区（每日开灯时段按此时区的本地挂钟时间解释）
TZ=Asia/Shanghai
